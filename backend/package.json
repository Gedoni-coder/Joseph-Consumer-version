{
  "name": "joseph-ai-backend",
  "version": "1.0.0",
  "description": "Backend API for JOSEPH AI - Family Finance & Business Management",
  "private": true,
  "packageManager": "pnpm@10.18.1",
  "type": "commonjs",
  "main": "dist/index.js",
  "scripts": {
    "prepare": "cd .. && husky backend/.husky",
    "commitlint": "commitlint --config commitlint.config.cjs",
    "lint": "eslint .",
    "typecheck": "pnpm build:core && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "prisma:validate": "prisma validate",
    "prisma:generate": "prisma generate",
    "migrate:dev": "prisma migrate dev",
    "migrate:deploy": "prisma migrate deploy",
    "studio": "prisma studio",
    "build:core-errors": "pnpm --dir core/errors build",
    "build:core-messages": "pnpm --dir core/messages build",
    "build:core-jwt": "pnpm --dir core/jwt build",
    "build:core-logger": "pnpm --dir core/logger build",
    "build:core-db": "pnpm prisma:generate && pnpm --dir core/db build",
    "build:core-repository": "pnpm --dir core/repository build",
    "build:core": "pnpm build:core-errors && pnpm build:core-messages && pnpm build:core-jwt && pnpm build:core-logger && pnpm build:core-db && pnpm build:core-repository",
    "build": "pnpm build:core && tsc",
    "dev": "cross-env NODE_ENV=development nodemon --watch src --ext ts --exec ts-node src/index.ts",
    "start": "cross-env NODE_ENV=production node dist/index.js",
    "ci": "pnpm lint && pnpm typecheck && pnpm prisma:validate && pnpm test && pnpm build"
  },
  "keywords": [
    "finance",
    "business",
    "api",
    "express",
    "postgresql",
    "prisma",
    "typescript"
  ],
  "author": "JOSEPH AI",
  "license": "MIT",
  "dependencies": {
    "@app-core/db": "workspace:*",
    "@app-core/errors": "workspace:*",
    "@app-core/jwt": "workspace:*",
    "@app-core/logger": "workspace:*",
    "@app-core/messages": "workspace:*",
    "@app-core/repository": "workspace:*",
    "@prisma/adapter-pg": "^7.1.0",
    "@prisma/client": "^7.1.0",
    "axios": "^1.7.2",
    "bcrypt": "^6.0.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.2",
    "helmet": "^8.1.0",
    "joi": "^17.13.1",
    "jsonwebtoken": "^9.0.2",
    "node-cron": "^3.0.3",
    "pg": "^8.16.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@types/bcrypt": "^6.0.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/joi": "^17.2.3",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^25.0.3",
    "@types/pg": "^8.16.0",
    "@typescript-eslint/eslint-plugin": "^8.49.0",
    "@typescript-eslint/parser": "^8.49.0",
    "@vitest/coverage-v8": "^4.1.10",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.2",
    "husky": "^9.1.7",
    "nodemon": "^3.1.11",
    "prettier": "^3.7.4",
    "prisma": "^7.1.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
