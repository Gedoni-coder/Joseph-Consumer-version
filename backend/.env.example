# ==========================================
# JOSEPH AI - Backend Environment Variables
# Copy this file to .env and fill in your values
# ==========================================

# Server Configuration
NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:3000

# ==========================================
# DATABASE CONFIGURATION
# PostgreSQL via Prisma
# ==========================================

# Neon (PostgreSQL) - Get your connection string from https://neon.tech
DATABASE_URL=postgresql://user:password@host:5432/database?schema=public
# Example Neon URL:
# DATABASE_URL=postgresql://johndoe:lost-password@ep-cool-darkness-123456.us-east-2.aws.neon.tech/neondb?sslmode=require
# Get your free Neon database at: https://neon.tech

# JWT Secrets (Generate secure random strings)
# Use: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your-super-secret-access-token-key-minimum-32-characters
JWT_REFRESH_SECRET=your-super-secret-refresh-token-key-minimum-32-characters

# JWT Expiration
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

# External API Keys (Optional - for dataEngine)
NEWS_API_KEY=your-news-api-key
TRADING_ECONOMICS_API_KEY=your-trading-economics-key
FMQD_API_KEY=your-fmdq-api-key

# Webhook Security
# Generate a secure signature for webhook verification
WEBHOOK_SECRET=your-webhook-signature-secret

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL=info

# Email (Optional - for password reset, notifications)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=

# ==========================================
# Development Notes:
# 1. Never commit .env file to version control
# 2. Use strong, randomly generated secrets
# 3. In production, use environment variables or secrets manager
# ==========================================
