# WhatsApp Bot Configuration
BOT_NAME=JOSEPH AI
BOT_PHONE_NUMBER=

# Backend API Configuration
BACKEND_API_URL=http://localhost:4000/api
BACKEND_API_KEY=

# Session Configuration
SESSIONS_DIR=./sessions
SESSION_ID=joseph-ai-bot

# Bot Behavior
AUTO_READ=false
AUTO_TYPING=true
MESSAGE_DELAY_MS=1000

# Rate Limiting
MAX_MESSAGES_PER_MINUTE=20
GROUPS_ENABLED=false

# Feature Flags
ENABLE_DREAM_MODULE=true
ENABLE_STRATEGY_MODULE=true
ENABLE_FINANCE_MODULE=true
ENABLE_INTERPRETATION_MODULE=true

# Logging
LOG_LEVEL=info
LOG_FILE=./logs/bot.log

# Security
ALLOWED_NUMBERS=*
ADMIN_NUMBERS=

# Message Templates
WELCOME_MESSAGE=Welcome to JOSEPH AI! 🎈 I'm your personal economist.
HELP_MESSAGE=Available commands: /balance, /budget, /goals, /economic, /help
